# Ship — example environment contract (instruction-first)
#
# This file is a TEMPLATE for target product repos.
# Keep it vendor-neutral where possible; fill only what your setup uses.

# --- Core identity ---
PROJECT_NAME=
MAIN_BRANCH=main

# --- Tracker adapter (choose what you actually use) ---
TRACKER_SYSTEM=linear      # linear | jira | github | azure-devops | clickup | spreadsheet | custom
TRACKER_TEAM=
TRACKER_PROJECT=
TRACKER_QUEUE_STATE=Todo

# Optional tracker credentials / hints
LINEAR_API_KEY=
JIRA_HOST=
JIRA_PAT=
GITHUB_TOKEN=
AZURE_DEVOPS_ORG=
AZURE_DEVOPS_PROJECT=
AZURE_DEVOPS_PAT=
CLICKUP_API_TOKEN=
CLICKUP_LIST_ID=

# --- Agent runtime ---
AGENT_PROVIDER=cursor      # cursor | codex | claude | copilot | custom
CURSOR_API_KEY=

# --- Delivery and quality ---
STAGING_URL=
PRODUCTION_URL=
REGRESSION_WORKFLOW_NAME=

# --- Daily communication (recommended: distribution lists) ---
DAILY_DIGEST_EMAIL=
DAILY_RETRO_EMAIL=

# --- Optional notifications ---
REVIEW_NOTIFY_EMAIL=

# --- Optional security scan ---
SNYK_TOKEN=

# Notes:
# 1) Do not commit real values.
# 2) Add provider-specific vars in your product repo as needed.
# 3) The adoption agent should ask before introducing any additional vars.

# --- Ship repo: Next.js site (see landing/.env.example) ---
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_DOCS_URL=http://localhost:3000   # optional; defaults to SITE_URL — manual is /docs on same app
# TOGETHER_API_KEY=            # Together AI — hero/marketing image generation (server-side only)
# TOGETHER_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell

# --- Ship cloud platform — backend (RFC-0006) ---
# Used by docker-compose (`docker compose up`) and by `ship-server` / `ship-worker`
# directly. The same shape works against a local Postgres+pgvector container,
# a self-hosted Postgres in your org, or Neon in our SaaS.
#
# DATABASE_URL=postgresql+asyncpg://ship:ship@localhost:5433/ship
# ALEMBIC_DATABASE_URL=                # Optional: override sync URL for migrations
# REDIS_URL=redis://localhost:6380/0
# S3_ENDPOINT_URL=http://localhost:9000   # Leave empty when using real AWS S3
# S3_BUCKET=ship-documents
# S3_ACCESS_KEY=shipminio
# S3_SECRET_KEY=shipminio
# S3_REGION=us-east-1
# JWT_SECRET=change-me-to-a-long-random-string
# JWT_ALGORITHM=HS256
# JWT_TTL_SECONDS=43200
# ENCRYPTION_KEY=                       # 32-byte urlsafe base64; required to store integration secrets
# SHIP_PUBLIC_URL=http://localhost:8100
# SHIP_AUTH_MODE=local                  # local (dev) | auth0 (prod). flip to auth0 once AUTH0_* are set

# --- Git sync worker ---
# Cloned remote artifact repos land under <root>/<workspace_id>/<repo_id>/.
# In docker-compose this is a named volume; on a single host self-hosted
# install, point it at a persistent disk so clones survive restarts.
# REPO_CACHE_ROOT=/var/lib/ship/repo-cache
# REPO_SYNC_INTERVAL_MINUTES=10         # cron tick spacing for the worker

# --- Observability (Sentry, RFC-0006 phase 2) ---
# Empty SENTRY_DSN means "off" everywhere — backend, console server, console
# browser. We split the public (browser-readable) variants so you can run
# the SDK only on the server until you're ready to enable client error
# capture. For Bunny.net deploy: set both DSN values to the same project.
# SENTRY_DSN=https://<public>@o<org>.ingest.sentry.io/<project>
# SENTRY_ENVIRONMENT=local                 # local | pilot | production
# SENTRY_TRACES_SAMPLE_RATE=0.0            # 0..1; bump on prod to ~0.1 once stable
# NEXT_PUBLIC_SENTRY_DSN=                  # set to enable browser error capture
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=local
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.0
# SHIP_VERSION=                            # tagged onto every Sentry release

# --- Auth0 (set when SHIP_AUTH_MODE=auth0) ---
# Create a Regular Web Application + an API in your Auth0 tenant. Console
# (Next.js) acts as the OIDC client; backend validates the resulting access
# token via the tenant JWKS. Run scripts/bootstrap.sh --auth0 ... to fill these.
# AUTH0_DOMAIN=your-tenant.eu.auth0.com
# AUTH0_AUDIENCE=https://api.ship.local      # API identifier in Auth0
# AUTH0_CLIENT_ID=
# AUTH0_CLIENT_SECRET=
# AUTH0_SESSION_SECRET=                       # 32-byte hex; used by @auth0/nextjs-auth0 cookie
# AUTH0_BASE_URL=http://localhost:3001        # base URL the user hits (Console)
# AUTH0_ISSUER_BASE_URL=https://your-tenant.eu.auth0.com
# SHIP_API_PORT=8100
# SHIP_CONSOLE_PORT=3001                # operator UI; landing/ stays on the public web, not in compose
# POSTGRES_USER=ship
# POSTGRES_PASSWORD=ship
# POSTGRES_DB=ship
# POSTGRES_PORT=5433
# REDIS_PORT=6380
# S3_PORT=9000
# S3_CONSOLE_PORT=9001
