# Linear API key (required for linear-agent CLI)
# Create at https://linear.app/settings/api
LINEAR_API_KEY=lin_api_...

# Linear team for SDLC setup (setup-linear-sdlc.mjs)
# Use team key (e.g. ELM) or team UUID
LINEAR_TEAM_KEY=ELM

# Cursor Cloud Agents API (cloud-agent-launch.sh, GitHub Actions)
# From https://cursor.com/dashboard?tab=integrations
CURSOR_API_KEY=crsr_...

# GitHub token for PR creation (pr-create command)
# Create at https://github.com/settings/tokens (repo scope)
GITHUB_TOKEN=ghp_...

# SendGrid for "Ready for review" email to support@elmundi.com
# Optional: SENDGRID_FROM_EMAIL, SENDGRID_FROM_NAME (default: noreply@elmundi.com)
SENDGRID_API_KEY=SG....
