# ─── Tracker for dist/cli.js (ship-agent) ──────────────────────────────────
# linear | jira | github | azure-devops | clickup  (aliases: azdo → azure-devops)
# TRACKER_PROVIDER=linear

# ─── Linear (pick scripts, CLI, cloud-agent-launch) ─────────────────────────
# https://linear.app/settings/api
LINEAR_API_KEY=lin_api_...

# ─── Jira Cloud (when TRACKER_PROVIDER=jira) ───────────────────────────────
# Site host only, e.g. your-org.atlassian.net (https:// optional)
# JIRA_HOST=your-org.atlassian.net
# Prefer API token as PAT (Bearer):
# JIRA_PAT=
# Or classic Cloud API token + Atlassian account email (Basic):
# JIRA_EMAIL=you@example.com
# JIRA_API_TOKEN=

# ─── GitHub Issues (when TRACKER_PROVIDER=github) ─────────────────────────
# Repo for Issues API (same token can serve PR commands if scopes allow).
# GITHUB_REPOSITORY=owner/repo
# Or: GITHUB_ISSUES_OWNER=owner  +  GITHUB_ISSUES_REPO=repo
# GITHUB_TOKEN=ghp_...
# Optional dedicated token: GITHUB_ISSUES_TOKEN=
# Open-issue workflow state is stored as label ship-status:<StateName> (see tracker-common).

# ─── Azure DevOps Boards (when TRACKER_PROVIDER=azure-devops) ──────────────
# AZURE_DEVOPS_ORG=myorg
# AZURE_DEVOPS_PROJECT=MyProject
# AZURE_DEVOPS_PAT=  (PAT with Work Items read/write; use empty user Basic :pat)
# Ship labels = work item Tags (ready:developer, flow:no-ba, …).
# System.State names must match your process (e.g. In Progress, Done).

# ─── ClickUp (when TRACKER_PROVIDER=clickup) ───────────────────────────────
# CLICKUP_API_TOKEN=
# CLICKUP_LIST_ID=  (list where tasks live)
# CLICKUP_TEAM_ID=  (optional; for custom task ids in get/issue refs)

# Team key (e.g. ENG) — used in prompts / snapshots
LINEAR_TEAM_KEY=YOUR_TEAM

# SDLC delivery lane: UUID of the Linear project automation should pick from,
# OR set LINEAR_SDLC_PROJECT_NAME and let scripts resolve it.
LINEAR_SDLC_PROJECT_ID=
LINEAR_SDLC_PROJECT_NAME=

# Daily audit targets (names resolved to project IDs if UUIDs not set)
LINEAR_TECH_DEBT_PROJECT_ID=
LINEAR_TECH_DEBT_PROJECT_NAME=Tech debt
LINEAR_SECURITY_PROJECT_ID=
LINEAR_SECURITY_PROJECT_NAME=Security

# ─── Optional: seed script create-prerelease-e2e-bugs.mjs ───────────────────
# Linear UUIDs from your workspace (GraphQL or browser devtools). See docs/examples/elmundi/.
LINEAR_E2E_ISSUE_SEED_PROJECT_ID=
# Or reuse LINEAR_SDLC_PROJECT_ID for the target project.
LINEAR_TEAM_UUID=
LINEAR_STATE_BACKLOG_UUID=
LINEAR_LABEL_BUG_UUID=
# Base URL written into seeded issue bodies (else falls back to PLAYWRIGHT_BASE_URL, else placeholder)
# E2E_ISSUE_SEED_BASE_URL=https://your-dev.example.com

# ─── Cursor Cloud Agents ───────────────────────────────────────────────────
# https://cursor.com/dashboard?tab=integrations
CURSOR_API_KEY=crsr_...

# ─── GitHub ─────────────────────────────────────────────────────────────────
# https://github.com/settings/tokens (repo scope)
GITHUB_TOKEN=ghp_...

# Comma-separated HTML comment markers used in PR comments for preview deploy detection
# (default in code: <!-- ship-pr-preview -->). Legacy: add <!-- elmundi-preview --> if needed.
# GITHUB_PR_PREVIEW_COMMENT_MARKERS=<!-- ship-pr-preview -->,<!-- elmundi-preview -->

# ─── SendGrid (optional “ready for review” email from dist/cli.js paths) ───
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@example.com
SENDGRID_FROM_NAME=Ship SDLC
# If unset, no email is sent.
IN_REVIEW_NOTIFY_EMAIL=
