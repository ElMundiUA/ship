# Скопируй в `.env` локально или задай в CI. Таргет — **задеплоенный dev** консоли + тот же backend.
# Никогда не комить реальные токены.

# Обязательно для любых тестов, которые бьют в консоль по HTTP
E2E_CONSOLE_BASE_URL=https://console.dev.example.com

# Ship FastAPI (`SHIP_API_URL` на консоли) — для API health, ship-api.*, journey (seed через REST)
E2E_SHIP_API_BASE=https://api.dev.example.com

# Mint в Console (workspace admin) — нужен для POST /clarifications, /improvements и для ship-api.sandbox
E2E_SHIP_API_TOKEN=ship_your_token

# Опционально, если не первый воркспейс в аккаунте
# E2E_WORKSPACE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Сессия браузера после логина (Auth0) — см. e2e/README.md; для journey + wired
# E2E_STORAGE_STATE=e2e/.auth/user.json

# Песочница GitHub (файлы репо, Actions, лейблы)
# E2E_SANDBOX_REPO=your-org/e2e-sandbox
# GITHUB_TOKEN=ghp_...

# ---- Full-journey (phase H) — опционально ----
# Включает tests/full-journey.wired.spec.ts; требует также E2E_STORAGE_STATE + E2E_SANDBOX_REPO
# E2E_RUN_FULL_JOURNEY=1
# E2E_PRESET=web-app
# E2E_RUN_GITHUB_APP_INSTALL=1
# E2E_GITHUB_INSTALL_ACCOUNT=YourOrg
# E2E_GITHUB_REPO_FULL_NAME=your-org/e2e-sandbox

# ---- Reset sandbox — только по запросу, деструктивно ----
# E2E_RESET_SANDBOX=1
# E2E_RESET_DELETE_BRANCHES=1
