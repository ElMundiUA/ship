# Скопируй в `.env` локально или задай в CI. Таргет — **задеплоенный dev** консоли + тот же backend.
# Никогда не комить реальные токены.

# Обязательно для любых тестов, которые бьют в консоль по HTTP
E2E_CONSOLE_BASE_URL=https://console.dev.example.com

# Ship FastAPI (`SHIP_API_URL` на консоли) — для API health, ship-api.*, journey (seed через REST)
E2E_SHIP_API_BASE=https://api.dev.example.com

# Mint в Console (workspace admin) — нужен для POST /clarifications, /improvements и для ship-api.sandbox
E2E_SHIP_API_TOKEN=ship_your_token

# Опционально, если не первый воркспейс в аккаунте
# E2E_WORKSPACE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Сессия браузера после логина (Auth0) — см. e2e/README.md; для journey + wired
# E2E_STORAGE_STATE=e2e/.auth/user.json
# Опционально: отдельная сессия invitee-аккаунта, email которого совпадает
# с Mailosaur invite address. Без нее live invite test проверит доставку и
# invite page, но пропустит фактический accept.
# E2E_INVITEE_STORAGE_STATE=e2e/.auth/invitee.json

# Песочница GitHub (файлы репо, Actions, лейблы)
# E2E_SANDBOX_REPO=your-org/e2e-sandbox
# GITHUB_TOKEN=ghp_...

# ---- Full-journey (phase H) — опционально ----
# Включает tests/full-journey.wired.spec.ts; требует также E2E_STORAGE_STATE + E2E_SANDBOX_REPO
# E2E_RUN_FULL_JOURNEY=1
# E2E_PRESET=web-app
# E2E_RUN_GITHUB_APP_INSTALL=1
# E2E_GITHUB_INSTALL_ACCOUNT=YourOrg
# E2E_GITHUB_REPO_FULL_NAME=your-org/e2e-sandbox

# ---- Live staging aggregate / Mailosaur / external integrations ----
# E2E_RUN_LIVE_FULL_JOURNEY=1
# E2E_RUN_MAILOSAUR=1
# MAILOSAUR_API_KEY=...
# MAILOSAUR_SERVER_ID=...
# По умолчанию адреса будут вида local@<MAILOSAUR_SERVER_ID>.mailosaur.net
# E2E_EMAIL_DOMAIN=<MAILOSAUR_SERVER_ID>.mailosaur.net

# E2E_RUN_EXTERNAL_INTEGRATIONS=1
# E2E_LINEAR_API_KEY=lin_api_...
# E2E_JIRA_SITE=your-site.atlassian.net
# E2E_JIRA_EMAIL=bot@example.com
# E2E_JIRA_API_TOKEN=...
# E2E_JIRA_PROJECT=SHIP
# E2E_NOTION_TOKEN=secret_...
# E2E_SLACK_BOT_TOKEN=xoxb-...
# E2E_GITLAB_TOKEN=glpat-...
# E2E_GITLAB_HOST=gitlab.com
# E2E_GITLAB_GROUP=your-group
# E2E_WEBHOOK_URL=https://example.com/e2e-webhook
# E2E_WEBHOOK_SECRET=ship-e2e-webhook-secret
# E2E_TEAMS_WEBHOOK_URL=https://...
# E2E_OTEL_ENDPOINT=https://otel.example.com/v1/traces
# E2E_OTEL_BEARER_TOKEN=ship-e2e-otel-token
# E2E_S3_BUCKET=ship-e2e-export
# E2E_S3_REGION=us-east-1
# E2E_S3_ACCESS_KEY_ID=...
# E2E_S3_SECRET_ACCESS_KEY=...
# E2E_AZURE_DEVOPS_ORG=your-org
# E2E_AZURE_DEVOPS_PAT=...
# E2E_AZURE_DEVOPS_PROJECT=your-project

# ---- Reset sandbox — только по запросу, деструктивно ----
# E2E_RESET_SANDBOX=1
# E2E_RESET_DELETE_BRANCHES=1
# E2E_RESET_EXTERNAL_INTEGRATIONS=1
