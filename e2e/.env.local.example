# E2E config — laptop-offline profile.
#
# Pairs with `make dev-up` (local Postgres + backend on :8100 +
# console on :3001 + Memory adapters). Pointing the suite at
# localhost means no Neon round-trips and no shared Auth0 / OpenAI
# spend during regression. Set up via:
#
#     # 1) bring up the stack
#     make dev-up
#
#     # 2) seed the e2e-navigator workspace + service users + PATs
#     #    into the LOCAL postgres
#     DATABASE_URL=postgresql://ship:ship@localhost:5433/ship \
#       E2E_SETUP_OPERATOR_EMAIL=dev@ship.dev \
#       PYTHONPATH=apps .venv/bin/python \
#       tools/scripts/setup_e2e_navigator_workspace.py
#
#     # 3) copy this file to e2e/.env.local, paste the printed
#     #    workspace UUID + the two PATs, then run:
#     cd e2e && set -a && source .env.local && set +a
#     npx playwright test navigator-memory.wired navigator-tenancy --workers=1
#
# Don't commit your actual PATs — `e2e/.env.local` is gitignored
# by the root `.env.*` rule.

E2E_CONSOLE_BASE_URL=http://localhost:3001
E2E_SHIP_API_BASE=http://localhost:8100

# Filled in by the setup script:
E2E_NAVIGATOR_WORKSPACE_ID=
E2E_NAVIGATOR_PAT_PRIMARY=
E2E_NAVIGATOR_PAT_SECONDARY=

# Required for memory-helpers' shared workspace lookup (the older
# tests still use these). Same values as the *_NAVIGATOR_* ones.
E2E_WORKSPACE_ID=
E2E_SHIP_API_TOKEN=
E2E_SHIP_API_TOKEN_SECONDARY=
