# Ship — committed laptop-dev defaults.
#
# Loaded by `tools/scripts/run-with-dotenv.mjs` BEFORE `.env`, so any
# key here can be overridden by a developer's untracked `.env` file.
# Nothing secret lives in this file — `.gitignore` allowlists it via
# the `!.env.shared` rule alongside `.env.example`.
#
# Default profile: **laptop-offline**. Local Postgres via docker
# compose, local-mode auth (no Auth0 round-trip), blank third-party
# keys so the backend boots without complaining and orchestration
# code-paths that hit external services short-circuit. To debug
# against prod (Neon, prod Auth0, real OpenAI etc.) override the
# relevant keys in your own `.env`.

# ---------------------------------------------------------------------------
# Local Postgres (docker compose service `postgres`, port 5433 to
# avoid clashing with a system pg on 5432).
# ---------------------------------------------------------------------------
POSTGRES_USER=ship
POSTGRES_PASSWORD=ship
POSTGRES_DB=ship
POSTGRES_PORT=5433
REDIS_PORT=6380

DATABASE_URL=postgresql://ship:ship@localhost:5433/ship
ALEMBIC_DATABASE_URL=postgresql+psycopg://ship:ship@localhost:5433/ship

# ---------------------------------------------------------------------------
# Origins — match the Makefile dev defaults (DEV_BACKEND_PORT=8100,
# DEV_CONSOLE_PORT=3001). Used by Auth0 SDK (when enabled), OAuth
# callbacks, the install handshake, and the model_validator that
# refuses cloud-mode boot with localhost URLs.
# ---------------------------------------------------------------------------
SHIP_PUBLIC_URL=http://localhost:8100
SHIP_CONSOLE_URL=http://localhost:3001
APP_BASE_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# Auth — local-mode is the laptop default. Login posts username +
# password and the backend mints its own session JWT (no IDP). Flip
# to `auth0` in your `.env` only when you need to debug Auth0 itself;
# in that case also set the AUTH0_* keys in `.env`.
# ---------------------------------------------------------------------------
SHIP_AUTH_MODE=local

# ---------------------------------------------------------------------------
# Telemetry / third-party APIs — silent by default. Override any of
# these in `.env` to point at real services for a specific debug.
# ---------------------------------------------------------------------------
SENTRY_DSN=
NEXT_TELEMETRY_DISABLED=1
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Email provider blank = "don't send"; backend logs the would-be
# email instead. Step 2 of the local-dev plan adds Mailpit on
# :1025 (SMTP) + :8025 (web UI) so dev can see real flows.
EMAIL_PROVIDER=
SENDGRID_FROM_EMAIL=dev@localhost
SENDGRID_FROM_NAME=Ship Dev
