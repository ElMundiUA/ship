{
  "name": "ship-landing",
  "version": "0.11.2",
  "private": true,
  "scripts": {
    "predev": "node scripts/sync-book.mjs",
    "prebuild": "node scripts/sync-book.mjs",
    "dev": "next dev -p 3000",
    "dev:turbo": "next dev --turbopack -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "lint": "next lint",
    "book:charts": "node scripts/build-book-charts.mjs",
    "book:pdf": "node scripts/sync-book.mjs && node scripts/build-book-charts.mjs && node scripts/build-book-pdf.mjs"
  },
  "dependencies": {
    "next": "^15.2.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.21",
    "echarts": "^6.0.0",
    "eslint": "^9.23.0",
    "eslint-config-next": "^15.2.4",
    "jsdom": "^29.0.2",
    "md-to-pdf": "^5.2.5",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2"
  }
}
