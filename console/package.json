{
  "name": "ship-console",
  "version": "0.15.1",
  "private": true,
  "description": "Operator console for the Ship cloud platform — workspace catalog, knowledge buckets, daily/retro, telemetry. Runs as a separate Next.js app from the marketing landing.",
  "scripts": {
    "dev": "next dev -p 3001",
    "dev:turbo": "next dev --turbopack -p 3001",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3001}",
    "lint": "next lint"
  },
  "dependencies": {
    "@auth0/nextjs-auth0": "^4.18.0",
    "@sentry/nextjs": "^10.49.0",
    "jszip": "^3.10.1",
    "luxon": "^3.7.2",
    "next": "^15.2.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.23.0",
    "eslint-config-next": "^15.2.4",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2"
  }
}
